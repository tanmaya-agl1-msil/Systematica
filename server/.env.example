PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/systematica
CLIENT_ORIGIN=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════
# AI vision — architecture diagram import
# AI_PROVIDER: openai | huggingface | azure | anthropic
#   "openai" also covers Ollama, LM Studio, vLLM, llama.cpp, OpenRouter —
#   anything exposing an OpenAI-compatible /chat/completions endpoint.
# ═══════════════════════════════════════════════════════════════════════

# ─── Option 1: Muse-Glimmer-30B via HF Inference Providers (cloud) ───
AI_PROVIDER=huggingface
AI_BASE_URL=https://router.huggingface.co/v1
AI_MODEL=meta-models/Muse-Glimmer-30B
AI_API_KEY=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

# ─── Option 2: Muse-Glimmer-30B via Ollama (local, free) ───
# ollama pull hf.co/meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=hf.co/meta-models/Muse-Glimmer-30B-GGUF:Q4_K_M

# ─── Option 3: Muse-Glimmer-30B via LM Studio (local, free, GUI) ───
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:1234/v1
# AI_MODEL=lmstudio-community/Muse-Glimmer-30B-GGUF

# ─── Option 4: Muse-Glimmer-30B via vLLM (self-hosted GPU) ───
# vllm serve RedHatAI/Muse-Glimmer-30B-FP8-block --port 8000
# AI_PROVIDER=openai
# AI_BASE_URL=http://localhost:8000/v1
# AI_MODEL=RedHatAI/Muse-Glimmer-30B-FP8-block

# ─── Option 5: HF Dedicated Inference Endpoint ───
# AI_PROVIDER=openai
# AI_BASE_URL=https://<your-endpoint>.endpoints.huggingface.cloud/v1
# AI_MODEL=meta-models/Muse-Glimmer-30B
# AI_API_KEY=hf_xxx

# ─── Option 6: OpenAI ───
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o
# AI_API_KEY=sk-xxx

# ─── Option 7: Azure OpenAI / AI Foundry ───
# AI_PROVIDER=azure
# AI_BASE_URL=https://<resource>.openai.azure.com
# AI_MODEL=<deployment-name>
# AI_API_VERSION=2024-10-21
# AI_API_KEY=<azure-key>

# ─── Tuning (optional) ───
# AI_JSON_MODE=auto     # auto | on | off — some open-weight servers reject response_format
# AI_IMAGE_DETAIL=high  # high | low | off — "off" omits the field entirely
# AI_MAX_TOKENS=6000
